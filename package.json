{
  "name": "pluton",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test src/",
    "smoke": "vite build --mode smoke && node scripts/smoke.mjs",
    "deploy": "bash scripts/deploy.sh",
    "native:sync": "npm run build && npx cap sync",
    "native:assets": "bash scripts/mobile-assets.sh",
    "android": "npm run native:sync && npx cap open android",
    "ios": "npm run native:sync && npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "playwright": "^1.64.1",
    "supabase": "^2.121.0",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@supabase/supabase-js": "^2.118.0",
    "ts-fsrs": "^5.4.2"
  }
}
